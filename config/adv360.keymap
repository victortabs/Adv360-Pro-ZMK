#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick_tap_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hm_slow: hm_slow {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SLOW";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick_tap_ms = <250>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hm_fast: hm_fast {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_FAST";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        macro_palavra: macro_palavra {
            compatible = "zmk,behavior-hold-tap";
            label = "MACRO_PALAVRA";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick_tap_ms = <100>;
            flavor = "tap-preferred";
            bindings = <&selecionar_proxima_palavra>, <&selecionar_palavra>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CapsLock {
            bindings = <&linha_maiuscula>;
            key-positions = <46 59>;
        };

        Delet {
            bindings = <&kp DELETE>;
            key-positions = <46 65>;
        };

        CapsWords {
            bindings = <&caps_word>;
            key-positions = <46 62>;
        };
    };

    macros {
        selecionar_palavra: selecionar_palavra {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LEFT_ARROW) &kp LS(LA(RIGHT))>;
            label = "SELECIONAR_PALAVRA";
        };

        deletar_linha: deletar_linha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(RIGHT) &kp LS(LG(LEFT_ARROW)) &kp RG(DELETE)>;
            label = "DELETAR_LINHA";
        };

        selecionar_proxima_palavra: selecionar_proxima_palavra {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT &kp LS(LA(LEFT_ARROW))>;
            label = "SELECIONAR_PROXIMA_PALAVRA";
        };

        linha_maiuscula: linha_maiuscula {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(LEFT)) &kp LS(LA(LC(LG(U))))>;
            label = "LINHA_MAIUSCULA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL                         &hm_slow F2 N1         &kp N2              &kp N3            &kp N4            &kp N5   &tog 1                                                                                                      &mo 3          &kp N6   &kp N7           &kp N8           &kp N9               &kp N0                          &kp MINUS
&lt 6 TAB                         &kp Q                  &hm_slow LC(W) W    &lt 1 E           &kp R             &lt 4 T  &macro_palavra 0 0                                                                                          &mo 4          &kp Y    &kp U            &kp I            &kp O                &kp P                           &hm_slow LS(LC(RIGHT_GUI)) BACKSLASH
&hm RG(RC(RS(RIGHT_ALT))) ESCAPE  &hm_slow LEFT_SHIFT A  &hm LEFT_CONTROL S  &hm LEFT_ALT D    &hm LEFT_GUI F    &lt 5 G  &key_repeat         &kp ENTER  &kp LALT                          &kp RIGHT_CONTROL           &kp RIGHT_GUI  &kp BACKSPACE  &lt 4 H  &hm RIGHT_GUI J  &hm RIGHT_ALT K  &hm RIGHT_CONTROL L  &hm_fast RIGHT_SHIFT SEMICOLON  &hm LA(LC(RIGHT_GUI)) SQT
&kp LSHFT                         &hm_slow LG(Z) Z       &kp X               &hm_slow LG(C) C  &hm_slow LG(V) V  &kp B                                   &hm LC(LS(LEFT_ALT)) PAGE_UP      &hm LA(RIGHT_CONTROL) HOME                                &kp N    &kp M            &kp COMMA        &kp DOT              &kp FSLH                        &kp RSHFT
&sl 2                             &kp GRAVE              &kp CAPSLOCK        &kp UP_ARROW      &kp DOWN                   &kp BACKSPACE       &kp DEL    &hm LA(LEFT_GUI) PAGE_DOWN        &hm LC(RIGHT_GUI) END       &kp ENTER      &kp SPACE               &kp LEFT_ARROW   &kp RIGHT        &kp LEFT_BRACKET     &kp RIGHT_BRACKET               &sl 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp GRAVE  &trans             &trans             &trans     &trans     &trans  &trans                                              &mo 3          &kp F2                 &kp KP_NUM       &kp KP_EQUAL     &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &trans             &trans             &kp UP     &trans     &trans  &tog 7                                              &none          &kp LEFT_PARENTHESIS   &kp KP_N7        &kp KP_N8        &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp CAPS   &trans             &kp LEFT           &kp DOWN   &kp RIGHT  &trans  &none     &trans     &trans      &trans  &kp DEL    &kp BACKSPACE  &kp RIGHT_PARENTHESIS  &kp KP_N4        &kp KP_N5        &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &trans             &trans             &trans     &trans     &trans                       &trans      &trans                            &kp LS(COLON)          &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp RIGHT_CONTROL  &kp RS(RIGHT_ALT)  &kp ENTER  &kp SPACE          &kp BSPC  &kp SPACE  &trans      &trans  &kp ENTER  &kp KP_N0                             &kp COMMA        &kp N0           &kp KP_DOT     &kp EQUAL        &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1            &kp F2               &kp F3          &kp F4  &kp F5  &kp F6  &tog 1                                            &mo 3   &kp F7  &kp F8                    &kp F9                     &kp F10            &kp F11   &kp F12
&trans            &none                &none           &none   &none   &trans  &none                                             &none   &trans  &trans                    &none                      &trans             &trans    &kp NON_US_BACKSLASH
&linha_maiuscula  &macro_palavra 0 0   &none           &none   &none   &trans  &none      &trans     &trans      &trans  &trans  &none   &trans  &kp LS(LC(LEFT_BRACKET))  &none                      &kp LS(LC(RIGHT))  &trans    &kp LS(LA(LC(LG(RIGHT_BRACKET))))
&kp LSHFT         &selecionar_palavra  &deletar_linha  &none   &none   &trans                        &trans      &trans                  &trans  &trans                    &trans                     &trans             &trans    &trans
&trans            &key_repeat          &trans          &trans  &trans          &kp SPACE  &kp ENTER  &trans      &trans  &trans  &trans          &kp LS(LA(LC(LG(LEFT))))  &kp LS(LA(LC(LG(RIGHT))))  &kp LBKT           &kp RBKT  &trans
            >;
        };

        mod {
            display-name = "BT";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        Mouse {
            display-name = "Kp";
            bindings = <
&none  &none  &none           &mkp MCLK       &none            &none  &none                                           &none  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE  &kp K_PREVIOUS  &kp K_NEXT  &kp K_PLAY_PAUSE
&none  &none  &mkp LCLK       &mmv MOVE_UP    &mkp MB2         &none  &bootloader                                     &none  &none              &none            &none       &none           &none       &none
&none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none        &none     &none      &none  &none  &none  &none              &none            &none       &none           &none       &none
&none  &none  &none           &none           &none            &none                         &none      &none                &none              &none            &none       &none           &none       &none
&none  &none  &none           &none           &none                   &kp RET      &kp BSPC  &none      &none  &none  &none                     &none            &none       &none           &none       &none
            >;
        };

        Direcional {
            display-name = "Dir";
            bindings = <
&none  &none           &none             &none             &none                     &none  &none                                                  &none         &none        &kp F2                &kp EQUAL  &kp FSLH               &kp STAR   &none
&none  &none           &none             &kp LS(LEFT_ALT)  &kp LS(LEFT_COMMAND)      &none  &bootloader                                            &none         &key_repeat  &kp LEFT_PARENTHESIS  &kp UP     &kp RIGHT_PARENTHESIS  &kp MINUS  &none
&none  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LALT          &kp LGUI                  &none  &none        &none     &none      &none  &kp BSPC      &none         &kp RET      &kp LEFT              &kp DOWN   &kp RIGHT              &kp PLUS   &none
&none  &none           &none             &none             &kp LC(LA(LS(LEFT_GUI)))  &none                         &none      &none                              &none        &deletar_linha        &kp SPACE  &selecionar_palavra    &none      &none
&none  &none           &none             &none             &none                            &kp LSHFT    &kp BSPC  &none      &none  &kp LEFT_ALT  &kp LEFT_GUI               &kp BACKSPACE         &none      &none                  &none      &none
            >;
        };

        Hyper_layer {
            display-name = "Mod";
            bindings = <
&kp LS(LA(LC(EQUAL)))       &kp LS(LA(LC(N1)))         &kp LS(LA(LC(LG(N2))))  &kp LS(LA(LC(LG(N3))))  &kp LS(LA(LC(LG(N4))))          &kp LS(LA(LC(LG(N5))))  &tog 1                                                                                                                      &mo 3      &kp LS(LA(LC(LG(N6))))  &kp LS(LA(LC(LG(N7))))          &kp LS(LA(LC(LG(N8))))     &kp LS(LA(LC(LG(N9))))    &kp LS(LA(LC(LG(N0))))    &kp LS(LA(LC(LG(MINUS))))
&none                       &kp LS(LA(LC(LG(Q))))      &kp LS(LA(LC(LG(W))))   &kp LS(LA(LC(LG(E))))   &kp LS(LA(LC(LG(R))))           &kp LS(LA(LC(LG(T))))   &none                                                                                                                       &none      &kp LS(LA(LC(LG(Y))))   &kp LS(LA(LC(LG(U))))           &kp LS(LA(LC(LG(I))))      &kp LS(LA(LC(LG(O))))     &kp LS(LA(LC(LG(P))))     &kp LS(LA(LC(LG(BACKSLASH))))
&kp LS(LA(LC(LG(ESCAPE))))  &kp LS(LA(LC(LG(A))))      &kp LS(LA(LC(LG(S))))   &kp LS(LA(LC(LG(D))))   &kp LS(LA(LC(LG(F))))           &kp LS(LA(LC(LG(G))))   &key_repeat    &kp LS(LA(LC(LG(PG_UP))))  &kp LS(LA(LC(LG(PG_DN))))      &kp LS(LA(LC(LG(HOME))))  &kp LS(LA(LC(LG(END))))  &none      &kp LS(LA(LC(LG(H))))   &kp LA(LS(LC(LG(J))))           &kp LS(LA(LC(LG(K))))      &kp LS(LA(LC(LG(L))))     &kp LS(LA(LC(LG(SEMI))))  &kp LS(LA(LC(LG(SQT))))
&none                       &kp LS(LA(LC(LG(Z))))      &kp LS(LA(LC(LG(X))))   &kp LS(LA(LC(LG(C))))   &kp LS(LA(LC(LG(V))))           &kp LS(LA(LC(LG(B))))                                             &kp LEFT_ALT                   &kp RIGHT_CONTROL                                             &kp LS(LA(LC(LG(N))))   &kp LS(LC(LA(LG(M))))           &kp LS(LA(LC(LG(COMMA))))  &kp LS(LA(LC(LG(DOT))))   &kp LS(LA(LC(LG(FSLH))))  &none
&mo 2                       &kp LS(LA(LC(LG(GRAVE))))  &kp CAPSLOCK            &kp LS(LA(LC(LG(UP))))  &kp LS(LA(LC(LG(DOWN_ARROW))))                          &kp BACKSPACE  &kp RIGHT_GUI              &kp DEL                        &kp RIGHT_GUI             &kp ENTER                &kp SPACE                          &kp LS(LA(LC(LG(LEFT_ARROW))))  &kp LS(LA(LG(LC(RIGHT))))  &kp LS(LA(LC(LG(LBKT))))  &kp LS(LA(LC(LG(RBKT))))  &mo 2
            >;
        };

        layer_8 {
            display-name = "Kp";
            bindings = <
&kp GRAVE  &trans             &trans             &trans     &trans     &trans  &trans                                              &mo 3          &kp F2                 &kp KP_NUM       &kp KP_EQUAL     &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &trans             &trans             &kp UP     &trans     &trans  &tog 0                                              &none          &kp LEFT_PARENTHESIS   &kp KP_N7        &kp KP_N8        &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp CAPS   &trans             &kp LEFT           &kp DOWN   &kp RIGHT  &trans  &none     &trans     &trans      &trans  &kp DEL    &kp BACKSPACE  &kp RIGHT_PARENTHESIS  &kp KP_N4        &kp KP_N5        &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &trans             &trans             &trans     &trans     &trans                       &trans      &trans                            &kp LS(COLON)          &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp RIGHT_CONTROL  &kp RS(RIGHT_ALT)  &kp ENTER  &kp SPACE          &kp BSPC  &kp SPACE  &trans      &trans  &kp ENTER  &kp KP_N0                             &kp COMMA        &kp N0           &kp KP_DOT     &kp EQUAL        &mo 2
            >;
        };

        Lay_special {
            display-name = "Mod";
            bindings = <
&kp LS(LA(LC(EQUAL)))       &kp LS(LA(LC(N1)))         &kp LS(LA(LC(LG(N2))))  &kp LS(LA(LC(LG(N3))))  &kp LS(LA(LC(LG(N4))))          &kp LS(LA(LC(LG(N5))))  &tog 1                                                                                                                      &mo 3      &kp LS(LA(LC(LG(N6))))  &kp LS(LA(LC(LG(N7))))          &kp LS(LA(LC(LG(N8))))     &kp LS(LA(LC(LG(N9))))    &kp LS(LA(LC(LG(N0))))    &kp LS(LA(LC(LG(MINUS))))
&none                       &kp LS(LA(LC(LG(Q))))      &kp LS(LA(LC(LG(W))))   &kp LS(LA(LC(LG(E))))   &kp LS(LA(LC(LG(R))))           &kp LS(LA(LC(LG(T))))   &none                                                                                                                       &none      &kp LS(LA(LC(LG(Y))))   &kp LS(LA(LC(LG(U))))           &kp LS(LA(LC(LG(I))))      &kp LS(LA(LC(LG(O))))     &kp LS(LA(LC(LG(P))))     &kp LS(LA(LC(LG(BACKSLASH))))
&kp LS(LA(LC(LG(ESCAPE))))  &kp LS(LA(LC(LG(A))))      &kp LS(LA(LC(LG(S))))   &kp LS(LA(LC(LG(D))))   &kp LS(LA(LC(LG(F))))           &kp LS(LA(LC(LG(G))))   &key_repeat    &kp LS(LA(LC(LG(PG_UP))))  &kp LS(LA(LC(LG(PG_DN))))      &kp LS(LA(LC(LG(HOME))))  &kp LS(LA(LC(LG(END))))  &none      &kp LS(LA(LC(LG(H))))   &kp LA(LS(LC(LG(J))))           &kp LS(LA(LC(LG(K))))      &kp LS(LA(LC(LG(L))))     &kp LS(LA(LC(LG(SEMI))))  &kp LS(LA(LC(LG(SQT))))
&none                       &kp LS(LA(LC(LG(Z))))      &kp LS(LA(LC(LG(X))))   &kp LS(LA(LC(LG(C))))   &kp LS(LA(LC(LG(V))))           &kp LS(LA(LC(LG(B))))                                             &kp LEFT_ALT                   &kp RIGHT_CONTROL                                             &kp LS(LA(LC(LG(N))))   &kp LS(LC(LA(LG(M))))           &kp LS(LA(LC(LG(COMMA))))  &kp LS(LA(LC(LG(DOT))))   &kp LS(LA(LC(LG(FSLH))))  &none
&mo 2                       &kp LS(LA(LC(LG(GRAVE))))  &kp CAPSLOCK            &kp LS(LA(LC(LG(UP))))  &kp LS(LA(LC(LG(DOWN_ARROW))))                          &kp BACKSPACE  &kp RIGHT_GUI              &kp DEL                        &kp RIGHT_GUI             &kp ENTER                &kp SPACE                          &kp LS(LA(LC(LG(LEFT_ARROW))))  &kp LS(LA(LG(LC(RIGHT))))  &kp LS(LA(LC(LG(LBKT))))  &kp LS(LA(LC(LG(RBKT))))  &mo 2
            >;
        };
    };
};
