#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick_tap_ms = <250>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hmteste: hmteste {
            compatible = "zmk,behavior-hold-tap";
            label = "HMTESTE";
            bindings = <&none>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            hold-while-undecided;
        };
    };

    combos {
        compatible = "zmk,combos";

        CapsLock {
            bindings = <&kp CAPS>;
            key-positions = <46 59>;
        };

        Delet {
            bindings = <&kp DELETE>;
            key-positions = <46 65>;
        };

        CapsWords {
            bindings = <&caps_word>;
            key-positions = <46 59 47 58>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>, <&macro_press>;

            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL                         &kp N1            &kp N2              &kp N3          &kp N4          &kp N5   &tog 1                                                                                                                                 &mo 3      &kp N6  &kp N7           &kp N8           &kp N9               &kp N0                     &kp MINUS
&lt 0 TAB                         &kp Q             &kp W               &key_repeat     &kp R           &kp T    &none                                                                                                                                  &mo 0      &kp Y   &kp U            &kp I            &kp O                &kp P                      &kp EQUAL
&hm RG(RC(RS(RIGHT_ALT))) ESCAPE  &hm LEFT_SHIFT A  &hm LEFT_CONTROL S  &hm LEFT_ALT D  &hm LEFT_GUI F  &lt 4 G  &mo 2          &hm LS(LA(LC(LEFT_GUI))) PAGE_UP  &hm LC(LALT) PAGE_DOWN      &hm RG(RS(RIGHT_CONTROL)) HOME  &hm RS(RA(RC(RGUI))) END  &none      &kp H   &hm RIGHT_GUI J  &hm RIGHT_ALT K  &hm RIGHT_CONTROL L  &hm RIGHT_SHIFT SEMICOLON  &kp SQT
&kp LSHFT                         &kp Z             &kp X               &kp C           &kp V           &kp B                                                     &kp LEFT_ALT                &kp RIGHT_CONTROL                                                    &kp N   &kp M            &kp COMMA        &kp DOT              &kp FSLH                   &kp RSHFT
&mo 2                             &kp GRAVE         &kp CAPSLOCK        &kp UP          &kp DOWN                 &kp BACKSPACE  &kp RIGHT_GUI                     &kp DEL                     &kp RIGHT_GUI                   &kp ENTER                 &kp SPACE          &kp LEFT         &kp RIGHT        &kp LBKT             &kp RBKT                   &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp GRAVE  &trans             &trans             &trans     &trans     &trans  &trans                                              &mo 3      &kp F2                 &kp KP_NUM       &kp KP_EQUAL     &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &trans             &kp UP             &trans     &trans     &trans  &none                                               &none      &kp LEFT_PARENTHESIS   &kp KP_N7        &kp KP_N8        &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp LEFT           &kp DOWN           &kp RIGHT  &trans     &trans  &none     &trans     &trans      &trans  &trans     &none      &kp RIGHT_PARENTHESIS  &kp KP_N4        &kp KP_N5        &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &trans             &trans             &trans     &trans     &trans                       &trans      &trans                        &kp LS(COLON)          &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp RIGHT_CONTROL  &kp RS(RIGHT_ALT)  &kp ENTER  &kp SPACE          &kp BSPC  &kp SPACE  &trans      &trans  &kp ENTER  &kp KP_N0                         &kp COMMA        &kp N0           &kp KP_DOT     &kp EQUAL        &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2       &kp F3   &kp F4   &kp F5   &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8          &kp F9    &kp F10    &kp F11  &kp F12
&trans  &kp F21      &kp F22  &kp F23  &kp F24  &trans  &none                                       &none   &trans  &trans          &kp UP    &trans     &trans   &kp NON_US_BACKSLASH
&trans  &kp F17      &kp F18  &kp F19  &kp F20  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &kp LEFT_ARROW  &kp DOWN  &kp RIGHT  &trans   &trans
&trans  &kp F13      &kp F14  &kp F15  &kp F16  &trans                  &trans      &trans                  &trans  &trans          &trans    &trans     &trans   &trans
&trans  &key_repeat  &trans   &trans   &trans           &trans  &trans  &trans      &trans  &trans  &trans          &trans          &trans    &trans     &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        layer_4 {
            display-name = "Mod";
            bindings = <
&none   &none  &none  &none  &none  &none  &none                                                     &trans           &none  &none  &none  &none  &none  &none
&trans  &none  &none  &none  &none  &none  &bootloader                                               &bootloader      &none  &none  &none  &none  &none  &none
&trans  &none  &none  &none  &none  &none  &none        &none     &none      &bt BT_CLR  &none       &none            &none  &none  &none  &none  &none  &none
&trans  &none  &none  &none  &none  &none                         &none      &none                                    &none  &none  &none  &none  &none  &none
&trans  &none  &none  &none  &none         &kp RET      &kp BSPC  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &none  &none  &none  &none  &none
            >;
        };
    };
};
